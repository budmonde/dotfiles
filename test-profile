#!/usr/bin/env bash

set -euo pipefail

basedir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
profiles_dir="${basedir}/profiles/unix"

list_profiles() {
    find "${profiles_dir}" -maxdepth 1 -name '*.conf.yaml' ! -name '*.test.conf.yaml' -type f -printf '%f\n' |
        sed 's/\.conf\.yaml$//' |
        sort
}

valid_profiles="$(list_profiles)"
profiles=()
forwarded_arguments=()
forward=0
for argument in "$@"; do
    if [ "${forward}" -eq 0 ] && [ "${argument}" = "--" ]; then
        forward=1
        continue
    fi
    if [ "${forward}" -eq 0 ] && [[ "${argument}" = -* ]]; then
        forward=1
    fi
    if [ "${forward}" -eq 1 ]; then
        forwarded_arguments+=("${argument}")
    else
        profiles+=("${argument}")
    fi
done

if [ "${#profiles[@]}" -eq 0 ]; then
    echo "Available profiles:"
    echo "${valid_profiles}" | sed 's/^/  /'
    exit 0
fi

runner_arguments=(--root "${basedir}")
for profile in "${profiles[@]}"; do
    if ! grep -Fxq "${profile}" <<<"${valid_profiles}"; then
        echo "Error: Unknown profile: ${profile}" >&2
        echo "Valid profiles: $(paste -sd, <<<"${valid_profiles}")" >&2
        exit 1
    fi
    shared="${basedir}/profiles/${profile}.test.conf.yaml"
    platform="${profiles_dir}/${profile}.test.conf.yaml"
    found=0
    for config in "${shared}" "${platform}"; do
        if [ -f "${config}" ]; then
            runner_arguments+=(--config "${config}")
            found=1
        fi
    done
    if [ "${found}" -eq 0 ]; then
        echo "Error: No test configuration found for profile: ${profile}" >&2
        exit 1
    fi
done

git -C "${basedir}" submodule update --init --recursive envtest

exec uv run "${basedir}/envtest/envtest.py" \
    "${runner_arguments[@]}" \
    "${forwarded_arguments[@]}"
