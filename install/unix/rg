#!/usr/bin/env bash
set -euo pipefail

source "$DOTBOT_INSTALL_REPO_ROOT/install/lib/unix/lifecycle.sh"

bin_dir="$HOME/.local/bin"
binary="$bin_dir/rg"

ripgrep_target() {
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64) printf 'x86_64-unknown-linux-musl\n' ;;
        Linux:aarch64|Linux:arm64) printf 'aarch64-unknown-linux-gnu\n' ;;
        Darwin:x86_64) printf 'x86_64-apple-darwin\n' ;;
        Darwin:aarch64|Darwin:arm64) printf 'aarch64-apple-darwin\n' ;;
        *) return 1 ;;
    esac
}

installer_status() {
    if ! ripgrep_target >/dev/null; then
        printf 'unsupported\n'
        return
    fi
    local candidate installed latest
    candidate="$binary"
    [ -x "$candidate" ] || candidate="$(command -v rg || true)"
    if [ -z "$candidate" ]; then
        printf 'absent\n'
        return
    fi
    installed="$("$candidate" --version 2>/dev/null | head -1 | awk '{ print $2 }')"
    latest="$(installer_github_latest_version BurntSushi/ripgrep || true)"
    installer_version_state "$installed" "$latest"
}

install_ripgrep() {
    local version="$1"
    local target
    target="$(ripgrep_target)" || {
        installer_note 'ripgrep release installer does not support this host'
        return 1
    }
    if [ -z "$version" ]; then
        version="$(installer_github_latest_version BurntSushi/ripgrep || true)"
    fi
    [ -n "$version" ] || {
        installer_note 'Could not resolve a ripgrep release version'
        return 1
    }
    version="${version#v}"

    local temporary filename
    temporary="$(mktemp -d)"
    trap 'rm -rf "$temporary"' RETURN
    filename="ripgrep-${version}-${target}.tar.gz"
    curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/${version}/${filename}" -o "$temporary/$filename"
    tar -xzf "$temporary/$filename" -C "$temporary"
    "$temporary"/ripgrep-*/rg --version >&2
    mkdir -p "$bin_dir"
    mv "$temporary"/ripgrep-*/rg "$binary.new.$$"
    chmod +x "$binary.new.$$"
    mv -f "$binary.new.$$" "$binary"
    trap - RETURN
    rm -rf "$temporary"
}

installer_apply() {
    local state
    state="$(installer_status)"
    case "$state" in
        absent) install_ripgrep ''; installer_status ;;
        *) printf '%s\n' "$state" ;;
    esac
}

installer_upgrade() {
    if ! ripgrep_target >/dev/null; then
        printf 'unsupported\n'
        return
    fi
    install_ripgrep "$1"
    installer_status
}

installer_main "$@"
