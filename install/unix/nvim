#!/usr/bin/env bash
set -euo pipefail

source "$DOTBOT_INSTALL_REPO_ROOT/install/lib/unix/lifecycle.sh"

install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/nvim-install"
bin_dir="$HOME/.local/bin"
binary="$install_dir/bin/nvim"

nvim_target() {
    [ "$(uname -s)" = Linux ] || return 1
    case "$(uname -m)" in
        x86_64) printf 'x86_64\n' ;;
        aarch64|arm64) printf 'arm64\n' ;;
        *) return 1 ;;
    esac
}

installer_status() {
    if ! nvim_target >/dev/null; then
        printf 'unsupported\n'
        return
    fi
    local candidate installed latest
    candidate="$binary"
    [ -x "$candidate" ] || candidate="$(command -v nvim || true)"
    if [ -z "$candidate" ]; then
        printf 'absent\n'
        return
    fi
    installed="$("$candidate" --version 2>/dev/null | head -1 | awk '{ print $2 }' | sed 's/^v//')"
    latest="$(installer_github_latest_version neovim/neovim || true)"
    installer_version_state "$installed" "$latest"
}

install_nvim() {
    local version="$1"
    local arch
    arch="$(nvim_target)" || {
        installer_note 'Neovim release installer supports Linux x64 and arm64 only'
        return 1
    }
    local filename="nvim-linux-${arch}.tar.gz"
    local url="https://github.com/neovim/neovim/releases/latest/download/$filename"
    if [ -n "$version" ]; then
        url="https://github.com/neovim/neovim/releases/download/v${version#v}/$filename"
    fi

    mkdir -p "$(dirname "$install_dir")"
    local temporary staging backup=
    temporary="$(mktemp -d)"
    staging="$(mktemp -d "${install_dir}.install.XXXXXX")"
    cleanup_nvim() {
        rm -rf "$temporary"
        [ ! -d "$staging" ] || rm -rf "$staging"
        if [ -n "$backup" ] && [ ! -e "$install_dir" ] && [ -e "$backup" ]; then
            mv "$backup" "$install_dir"
        fi
    }
    trap cleanup_nvim RETURN

    curl -fsSL "$url" -o "$temporary/$filename"
    tar -xzf "$temporary/$filename" -C "$temporary"
    mv "$temporary"/nvim-linux-*/* "$staging/"
    "$staging/bin/nvim" --version >&2

    if [ -d "$install_dir" ]; then
        backup="${install_dir}.previous.$$"
        mv "$install_dir" "$backup"
    elif [ -e "$install_dir" ]; then
        installer_note "Refusing to replace non-directory Neovim installation: $install_dir"
        return 1
    fi
    mv "$staging" "$install_dir"
    staging=
    mkdir -p "$bin_dir"
    ln -sfn "$binary" "$bin_dir/nvim"
    if [ -n "$backup" ]; then
        rm -rf "$backup"
        backup=
    fi
    trap - RETURN
    rm -rf "$temporary"
}

installer_apply() {
    local state
    state="$(installer_status)"
    case "$state" in
        absent) install_nvim ''; installer_status ;;
        *) printf '%s\n' "$state" ;;
    esac
}

installer_upgrade() {
    if ! nvim_target >/dev/null; then
        printf 'unsupported\n'
        return
    fi
    install_nvim "$1"
    installer_status
}

installer_main "$@"
