#!/usr/bin/env bash
set -euo pipefail

source "$DOTBOT_INSTALL_REPO_ROOT/install/lib/unix/lifecycle.sh"

install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/texlive"

texlive_supported() {
    [ "$(uname -s)" = Linux ] && [ -z "${SLURM_CONF:-}" ]
}

texlive_binary_dir() {
    [ -d "$install_dir/bin" ] || return 1
    find "$install_dir/bin" -mindepth 1 -maxdepth 1 -type d -print -quit
}

installer_status() {
    if ! texlive_supported; then
        printf 'unsupported\n'
    elif texlive_binary_dir >/dev/null; then
        printf 'current\n'
    else
        printf 'absent\n'
    fi
}

install_texlive() {
    local temporary archive installer_dir
    temporary="$(mktemp -d)"
    trap 'rm -rf "$temporary"' RETURN
    archive="$temporary/install-tl-unx.tar.gz"
    curl -fsSL https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz -o "$archive"
    installer_dir="$(tar -tzf "$archive" | head -1 | cut -d/ -f1)"
    [ -n "$installer_dir" ] || {
        installer_note 'Could not determine the TeX Live installer directory'
        return 1
    }
    tar -xzf "$archive" -C "$temporary"
    perl "$temporary/$installer_dir/install-tl" --no-interaction --texdir="$install_dir" >&2
    texlive_binary_dir >&2
    trap - RETURN
    rm -rf "$temporary"
}

installer_apply() {
    local state
    state="$(installer_status)"
    if [ "$state" = absent ]; then
        install_texlive
        installer_status
    else
        printf '%s\n' "$state"
    fi
}

installer_upgrade() {
    if [ -n "$1" ]; then
        installer_note 'TeX Live does not support requested-version upgrades'
        return 1
    fi
    if ! texlive_supported; then
        printf 'unsupported\n'
        return
    fi
    local binary_dir
    binary_dir="$(texlive_binary_dir || true)"
    if [ -z "$binary_dir" ]; then
        install_texlive
    else
        "$binary_dir/tlmgr" update --self --all >&2
    fi
    installer_status
}

installer_main "$@"
