#!/usr/bin/env bash
set -euo pipefail

source "$DOTBOT_INSTALL_REPO_ROOT/install/lib/unix/lifecycle.sh"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
install_dir="$data_home/fzf"
binary="$install_dir/bin/fzf"

installer_status() {
    if [ ! -x "$binary" ]; then
        printf 'absent\n'
        return
    fi
    local installed latest
    installed="$("$binary" --version 2>/dev/null | awk '{ print $1 }')"
    latest="$(installer_github_latest_version junegunn/fzf || true)"
    installer_version_state "$installed" "$latest"
}

install_fzf() {
    local version="$1"
    if [ -z "$version" ]; then
        version="$(installer_github_latest_version junegunn/fzf || true)"
    fi
    [ -n "$version" ] || {
        installer_note 'Could not resolve an fzf release version'
        return 1
    }
    version="${version#v}"
    for command in curl tar; do
        command -v "$command" >/dev/null 2>&1 || {
            installer_note "Missing required command: $command"
            return 1
        }
    done

    mkdir -p "$data_home"
    local staging backup=
    staging="$(mktemp -d "$data_home/fzf.install.XXXXXX")"
    cleanup_fzf() {
        [ ! -d "$staging" ] || rm -rf "$staging"
        if [ -n "$backup" ] && [ ! -e "$install_dir" ] && [ -e "$backup" ]; then
            mv "$backup" "$install_dir"
        fi
    }
    trap cleanup_fzf RETURN

    curl -fsSL "https://github.com/junegunn/fzf/archive/refs/tags/v$version.tar.gz" |
        tar -xz --strip-components=1 -C "$staging"
    "$staging/install" --bin >&2
    "$staging/bin/fzf" --version >&2

    if [ -e "$install_dir" ] && [ ! -d "$install_dir" ]; then
        installer_note "Refusing to replace non-directory fzf installation: $install_dir"
        return 1
    fi
    if [ -d "$install_dir" ]; then
        backup="$data_home/fzf.previous.$$"
        mv "$install_dir" "$backup"
    fi
    mv "$staging" "$install_dir"
    staging=
    if [ -n "$backup" ]; then
        rm -rf "$backup"
        backup=
    fi
    trap - RETURN
}

installer_apply() {
    local state
    state="$(installer_status)"
    if [ "$state" != absent ]; then
        printf '%s\n' "$state"
        return
    fi
    install_fzf ''
    installer_status
}

installer_upgrade() {
    install_fzf "$1"
    installer_status
}

installer_main "$@"
