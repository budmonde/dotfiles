# shellenv is the shared environment loader for bash and zsh

. "$HOME/.config/shell/machine.sh" || return
[ -n "${DOTFILES_SHELL_DIR:-}" ] || return
. "$DOTFILES_SHELL_DIR/functions.sh"

if [ -f "$HOME/.shellenv_local_before" ]; then
    . "$HOME/.shellenv_local_before"
fi

. "$DOTFILES_SHELL_DIR/xdg.sh"
. "$DOTFILES_SHELL_DIR/bootstrap.sh"
. "$DOTFILES_SHELL_DIR/external.sh"

if [ -f "$HOME/.shellenv_local_after" ]; then
    . "$HOME/.shellenv_local_after"
fi
