#!/usr/bin/env node

"use strict";

const fs = require("fs");
const crypto = require("crypto");
const path = require("path");
const { spawnSync } = require("child_process");
const {
    appendAuditLog,
    gitOutput,
    makeDebug,
    sanitizeToAscii,
} = require(path.join(__dirname, "lib"));
const {
    applyVerdict,
    buildGateCommand,
    clearPendingReceipt,
    classifyRuntime,
    createInfrastructureReject,
    normalizeAuditBinding,
    normalizeStructuredVerdict,
    writePendingReceipt,
} = require(path.join(__dirname, "commit-auditor-controller"));

const HOOK_TAG = "[commit-msg]";
const MSG_FILE = process.argv[2];
const debug = makeDebug(HOOK_TAG);

function isSpecialCommit() {
    const gitDir = gitOutput("rev-parse --git-dir");
    if (!gitDir) return false;
    for (const marker of [
        "MERGE_MSG",
        "SQUASH_MSG",
        "CHERRY_PICK_HEAD",
        "REVERT_HEAD",
        "rebase-merge",
        "rebase-apply",
    ]) {
        if (fs.existsSync(path.join(gitDir, marker))) {
            debug(`skipping audit: ${marker} present`);
            return true;
        }
    }
    return false;
}

function stripComments(text) {
    return text
        .split(/\r?\n/)
        .filter((line) => !/^\s*#/.test(line))
        .join("\n")
        .replace(/\n+$/, "");
}

function subjectOf(text) {
    return stripComments(text).split(/\r?\n/)[0] || "";
}

function localPolicyCheck(messageText) {
    const subject = subjectOf(messageText);
    if (subject && !/^\[[^\]]+\] /.test(subject)) {
        process.stderr.write(
            `${HOOK_TAG} local-policy warning: subject missing [TAG] prefix per wiki/workflow.md commit convention.\n`,
        );
    }
}

function parseCommandJson(stdout) {
    const lines = stdout.trim().split(/\r?\n/).filter(Boolean);
    if (lines.length === 0) throw new Error("codex-ctl gate command returned no result");
    try {
        return JSON.parse(lines.at(-1));
    } catch (error) {
        throw new Error(`codex-ctl gate command returned invalid JSON: ${error.message}`);
    }
}

function resolveGitDir(repoTopLevel) {
    const gitDir =
        gitOutput("rev-parse --absolute-git-dir") ||
        path.resolve(repoTopLevel, gitOutput("rev-parse --git-dir"));
    if (!gitDir) throw new Error("unable to resolve the Git directory");
    return gitDir;
}

function captureAuditBinding() {
    const indexTree = gitOutput("write-tree");
    if (!indexTree) throw new Error("unable to capture the staged index tree");
    return normalizeAuditBinding({
        schemaVersion: 1,
        baseCommit: gitOutput("rev-parse --verify HEAD") || null,
        headRef: gitOutput("symbolic-ref -q HEAD") || null,
        indexTree,
    });
}

async function dispatchManaged(runtime, messageText, repoTopLevel, gitDir, auditBinding) {
    const gate = buildGateCommand(runtime, "invoke", ["git-commit", "--json"]);
    const child = spawnSync(gate.command, gate.args, {
        cwd: process.cwd(),
        encoding: "utf8",
        input: JSON.stringify({
            schemaVersion: 1,
            requestId: crypto.randomUUID(),
            executionContext: { cwd: repoTopLevel },
            payload: {
                gitDir,
                repoTopLevel,
                hookCwd: process.cwd(),
                proposedMessage: messageText,
                auditBinding,
            },
        }),
        maxBuffer: 4 * 1024 * 1024,
        timeout: 330_000,
        windowsHide: true,
    });
    if (child.error) throw child.error;
    if (child.status !== 0) {
        throw new Error(child.stderr.trim() || `codex-ctl gate command exited ${child.status}`);
    }
    const response = parseCommandJson(child.stdout);
    const verdict = normalizeStructuredVerdict(response);
    const verifiedAuditBinding = normalizeAuditBinding(response.auditBinding);
    return {
        verdict,
        receipt: verdict.kind === "REJECT"
            ? null
            : {
                schemaVersion: 2,
                gateId: response.gateId,
                invocationId: response.invocationId,
                finalizationToken: response.finalizationToken,
                generationId: response.generationId,
                originThreadId: response.originThreadId,
                auditBinding: verifiedAuditBinding,
            },
        gitDir,
        gateId: response.gateId,
        invocationId: response.invocationId,
        evaluatorThreadId: response.evaluatorThreadId,
        provenance: response.provenance || null,
        startedAt: response.createdAt || null,
        completedAt: response.updatedAt || null,
    };
}

async function sanitizeMessageFile() {
    const original = fs.readFileSync(MSG_FILE, "utf8");
    const sanitized = await sanitizeToAscii(original);
    if (sanitized.changed) {
        fs.writeFileSync(MSG_FILE, sanitized.text);
        process.stdout.write(
            `${HOOK_TAG} sanitized non-ASCII characters in commit message (see wiki/workflow.md ASCII rule).\n`,
        );
    }
    return sanitized.text;
}

function printVerdict(verdict, evaluatorThreadId, invocationId, originalMessage) {
    const output = verdict.kind === "REJECT" ? process.stderr : process.stdout;
    output.write(`${HOOK_TAG} ${verdict.kind}`);
    if (verdict.kind === "APPROVE") output.write(`: ${subjectOf(originalMessage)}`);
    output.write("\n");
    if (verdict.kind === "REWRITE") {
        output.write(`${HOOK_TAG}   original: ${subjectOf(originalMessage)}\n`);
        output.write(`${HOOK_TAG}   rewritten: ${subjectOf(verdict.message)}\n`);
    }
    if (verdict.rationale) {
        output.write(`${HOOK_TAG} rationale:\n`);
        for (const line of verdict.rationale.split(/\r?\n/)) {
            output.write(`${HOOK_TAG}   ${line}\n`);
        }
    }
    if (invocationId) output.write(`${HOOK_TAG} gate invocation: ${invocationId}\n`);
    if (evaluatorThreadId) {
        output.write(`${HOOK_TAG} evaluator session: ${evaluatorThreadId}\n`);
    }
}

async function main() {
    if (!MSG_FILE) {
        process.stderr.write(`${HOOK_TAG} usage: commit-msg <message-file>\n`);
        process.exit(1);
    }

    const runtime = classifyRuntime(process.env);
    let messageText;
    try {
        messageText = await sanitizeMessageFile();
    } catch (error) {
        process.stderr.write(`${HOOK_TAG} REJECT: cannot read or sanitize message (${error.message})\n`);
        process.exit(1);
    }

    if (isSpecialCommit() && !runtime.managed) process.exit(0);
    if (runtime.kind === "local") {
        localPolicyCheck(messageText);
        debug("outside an agent runtime; local policy mode");
        process.exit(0);
    }

    const repoTopLevel = gitOutput("rev-parse --show-toplevel") || process.cwd();
    let dispatch;
    let gitDir = null;
    if (runtime.kind === "invalid") {
        dispatch = {
            verdict: createInfrastructureReject(runtime.reason),
            gateId: null,
            invocationId: null,
            evaluatorThreadId: null,
            provenance: null,
            startedAt: null,
            completedAt: null,
        };
    } else {
        try {
            gitDir = resolveGitDir(repoTopLevel);
            clearPendingReceipt(gitDir);
            const auditBinding = captureAuditBinding();
            dispatch = await dispatchManaged(
                runtime,
                messageText,
                repoTopLevel,
                gitDir,
                auditBinding,
            );
            if (dispatch.verdict.kind !== "REJECT") {
                writePendingReceipt(gitDir, dispatch.receipt);
            }
        } catch (error) {
            if (gitDir) clearPendingReceipt(gitDir);
            dispatch = {
                verdict: createInfrastructureReject(error.message),
                gateId: null,
                invocationId: null,
                evaluatorThreadId: null,
                provenance: null,
                startedAt: null,
                completedAt: null,
            };
        }
    }

    let applyResult;
    try {
        applyResult = await applyVerdict(MSG_FILE, dispatch.verdict);
    } catch (error) {
        if (gitDir) clearPendingReceipt(gitDir);
        throw error;
    }
    appendAuditLog({
        provider: runtime.kind,
        result: dispatch.verdict.kind,
        infrastructure_failure: Boolean(dispatch.verdict.infrastructureFailure),
        verdict_source: dispatch.verdict.infrastructureFailure ? "controller" : "model",
        gate_id: dispatch.gateId || null,
        invocation_id: dispatch.invocationId || null,
        evaluator_session_id: dispatch.evaluatorThreadId || null,
        contract: dispatch.provenance?.contract || null,
        configuration_sha256: dispatch.provenance?.configurationSha256 || null,
        instruction_sha256: dispatch.provenance?.instructionSha256 || null,
        started_at: dispatch.startedAt,
        completed_at: dispatch.completedAt,
        latency_ms:
            dispatch.startedAt && dispatch.completedAt
                ? Date.parse(dispatch.completedAt) - Date.parse(dispatch.startedAt)
                : null,
        origin_session_id:
            runtime.managed ? runtime.originThreadId : null,
        generation_id: runtime.generationId,
        repo: repoTopLevel,
        git_dir: gitOutput("rev-parse --absolute-git-dir") || null,
        cwd: process.cwd(),
        original_message: messageText,
        rewritten_message:
            dispatch.verdict.kind === "REWRITE" ? dispatch.verdict.message : null,
        rationale: dispatch.verdict.rationale || null,
    });
    printVerdict(
        dispatch.verdict,
        dispatch.evaluatorThreadId,
        dispatch.invocationId,
        messageText,
    );
    process.exit(applyResult.exitCode);
}

main().catch((error) => {
    const runtime = classifyRuntime(process.env);
    appendAuditLog({
        provider: runtime.kind,
        result: "REJECT",
        infrastructure_failure: true,
        rationale: error.message,
    });
    process.stderr.write(
        `${HOOK_TAG} REJECT: commit audit infrastructure failed unexpectedly (${error.message})\n`,
    );
    debug(`unexpected error: ${error.stack || error.message}`);
    process.exit(1);
});
