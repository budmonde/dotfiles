"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" vimrc.after - Settings that require ~/.vim in runtimepath
" This file is sourced:
"   - In Vim (after vimrc.before, rtp already includes ~/.vim)
"   - In Neovim (after lazy.nvim sets up rtp via init.vim)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" Mongolian keymap - requires ~/.vim/keymap/ in runtimepath
" set keymap implicitly sets iminsert=1, so reset it after
set keymap=qwerty2mongolian
set iminsert=0

" Regenerate spell dictionary binary - requires ~/.vim/spell/ in runtimepath
" See: https://vi.stackexchange.com/questions/5050
for d in glob('~/.vim/spell/*.add', 1, 1)
    if filereadable(d) && (
    \   !filereadable(d . '.spl') || getftime(d) > getftime(d . '.spl')
    \)
        exec 'mkspell! ' . fnameescape(d)
    endif
endfor

augroup fugitive_commit_folding
    autocmd!
    autocmd User FugitiveCommit setlocal foldmethod=syntax
augroup END

function! s:ConfigureGclogPreview() abort
    if get(b:, 'dotfiles_gclog_preview_mapping', 0)
        silent! nunmap <buffer> p
        unlet b:dotfiles_gclog_preview_mapping
    endif

    if &buftype !=# 'quickfix'
        return
    endif

    let window_info = getwininfo(win_getid())
    if empty(window_info) || get(window_info[0], 'loclist', 0)
        return
    endif

    if get(getqflist({'title': 1}), 'title', '') =~# '^:Gclog\>'
        nnoremap <buffer> <silent> p <CR><C-W>p
        let b:dotfiles_gclog_preview_mapping = 1
    endif
endfunction

augroup gclog_preview
    autocmd!
    autocmd BufWinEnter * call <SID>ConfigureGclogPreview()
augroup END
